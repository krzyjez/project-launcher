<Window x:Class="ProjectLauncher.Wpf.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wybierz kolor"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="#090A0F"
        Foreground="#F7F2E8"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Window.Resources>
        <SolidColorBrush x:Key="TextMuted" Color="#85858F" />
        <SolidColorBrush x:Key="PanelBackground" Color="#15161B" />
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="#15161B" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#3C3E48" />
            <Setter Property="CaretBrush" Value="#FFFFFF" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style TargetType="{x:Type Button}">
            <Setter Property="MinWidth" Value="86" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Background" Value="#15161B" />
            <Setter Property="Foreground" Value="#F7F2E8" />
            <Setter Property="BorderBrush" Value="#7C5CFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#1C1F29" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#A483FF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.76" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SwatchButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="56" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderBrush" Value="#3C3E48" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#F7F2E8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="Kolor projektu"
                       FontSize="18"
                       FontWeight="SemiBold" />
            <TextBlock Text="Wybierz z palety albo wpisz wartosc recznie"
                       Foreground="{StaticResource TextMuted}"
                       FontSize="12"
                       Margin="0,4,0,0" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource PanelBackground}"
                    BorderBrush="#3C3E48"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="OriginalPreview"
                            CornerRadius="7"
                            BorderBrush="#3C3E48"
                            BorderThickness="1" />
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Bylo"
                                   Foreground="{StaticResource TextMuted}"
                                   FontSize="11" />
                        <TextBlock x:Name="OriginalValueText"
                                   Foreground="#F7F2E8"
                                   FontSize="12"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Background="{StaticResource PanelBackground}"
                    BorderBrush="#7C5CFF"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="SelectedPreview"
                            CornerRadius="7"
                            BorderBrush="#F7F2E8"
                            BorderThickness="1" />
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Wybrano"
                                   Foreground="{StaticResource TextMuted}"
                                   FontSize="11" />
                        <TextBlock x:Name="SelectedValueText"
                                   Foreground="#F7F2E8"
                                   FontSize="12"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2"
                   Text="Paleta"
                   Foreground="{StaticResource TextMuted}"
                   FontSize="12"
                   Margin="0,0,0,5" />

        <UniformGrid x:Name="PaletteGrid"
                     Grid.Row="3"
                     Columns="6"
                     Rows="5"
                     Width="376"
                     Height="244"
                     HorizontalAlignment="Left"
                     Margin="0,0,0,12" />

        <TextBlock Grid.Row="4"
                   Text="Wartosc HEX"
                   Foreground="{StaticResource TextMuted}"
                   FontSize="12"
                   Margin="0,0,0,5" />

        <Grid Grid.Row="5" Margin="0,0,0,2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBox x:Name="ColorBox"
                     Height="38"
                     TextChanged="ColorBox_TextChanged" />
            <TextBlock x:Name="ValidationText"
                       Grid.Row="1"
                       Text="Format: #RRGGBB"
                       Foreground="#FF5C8A"
                       FontSize="11"
                       HorizontalAlignment="Left"
                       Margin="0,5,0,0"
                       Visibility="Collapsed" />
        </Grid>

        <StackPanel Grid.Row="6"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Anuluj"
                    Click="CancelButton_Click"
                    Margin="0,0,8,0" />
            <Button Content="OK"
                    Click="SaveButton_Click" />
        </StackPanel>
    </Grid>
</Window>
