<Window x:Class="ProjectLauncher.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProjectLauncher.Wpf"
        mc:Ignorable="d"
        Title="Projekty"
        Width="1480"
        MinWidth="800"
        MinHeight="360"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#090A0F"
        Foreground="#F7F2E8"
        Loaded="Window_Loaded"
        KeyDown="Window_KeyDown"
        PreviewMouseLeftButtonDown="_Window_PreviewMouseLeftButtonDown">
    <Window.Resources>
        <local:ProjectColorToBrushConverter x:Key="ProjectColorToBrush" />
        <local:EmptyTextToVisibilityConverter x:Key="EmptyTextToVisibility" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibility" />

        <SolidColorBrush x:Key="CardBackground" Color="#15161B" />
        <SolidColorBrush x:Key="CardHoverBackground" Color="#1E2028" />
        <SolidColorBrush x:Key="TextMuted" Color="#85858F" />
        <SolidColorBrush x:Key="TextSubtle" Color="#C9C1AB" />
        <SolidColorBrush x:Key="Accent" Color="#FF6B1A" />

        <Style x:Key="ScrollBarPageButtonStyle" TargetType="{x:Type RepeatButton}">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LauncherScrollThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbBorder"
                                Background="#4A4E5A"
                                CornerRadius="5"
                                Margin="3,2" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#626879" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ThumbBorder" Property="Opacity" Value="0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="15" />
            <Setter Property="MinWidth" Value="15" />
            <Setter Property="Background" Value="#0F1016" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="#262933"
                                BorderThickness="1,0,0,0">
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True"
                                   Margin="1">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                  Style="{StaticResource ScrollBarPageButtonStyle}" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource LauncherScrollThumbStyle}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                  Style="{StaticResource ScrollBarPageButtonStyle}" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#D8D2C8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#24262D" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderToggleButtonStyle" TargetType="{x:Type ToggleButton}">
            <Setter Property="MinWidth" Value="74" />
            <Setter Property="Height" Value="34" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#D8D2C8" />
            <Setter Property="BorderBrush" Value="#383A43" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#24262D" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="#24262D" />
                                <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NeonOutlineButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#F7F2E8" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1E2028" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProjectCardContainerStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProjectCardStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{StaticResource CardBackground}" />
            <Setter Property="BorderThickness" Value="2.5" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource CardHoverBackground}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ProjectDescriptionToolTipStyle" TargetType="{x:Type ToolTip}">
            <Setter Property="Background" Value="#15161B" />
            <Setter Property="Foreground" Value="{StaticResource TextSubtle}" />
            <Setter Property="BorderBrush" Value="#383A43" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="MaxWidth" Value="360" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <!-- Ikonka rozwijania pojedynczej karty; nie otwiera projektu, bo przycisk sam obsluguje klikniecie -->
        <Style x:Key="ExpandToggleStyle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTip" Value="Rozwin szczegoly projektu" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="ExpandBorder"
                                Background="Transparent"
                                CornerRadius="5">
                            <TextBlock x:Name="ExpandGlyph"
                                       Text="&#xE70D;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="10"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ExpandBorder" Property="Background" Value="#2A2D36" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ExpandGlyph" Property="Text" Value="&#xE70E;" />
                                <Setter Property="ToolTip" Value="Zwin szczegoly projektu" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Kazdy element dostaje wlasna instancje dymka; wspolny obiekt ToolTip nie moze nalezec do kilku kart naraz -->
        <ToolTip x:Key="BranchDescriptionToolTip"
                 x:Shared="False"
                 Style="{StaticResource ProjectDescriptionToolTipStyle}">
            <TextBlock Text="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType={x:Type ToolTip}}}"
                       TextWrapping="Wrap" />
        </ToolTip>

        <!-- Nosnik dymka z opisem galezi: opis przychodzi w Tag, a pusty opis nie pokazuje pustego dymka -->
        <Style x:Key="BranchDescriptionHostStyle" TargetType="{x:Type Border}">
            <Setter Property="ToolTipService.InitialShowDelay" Value="250" />
            <Setter Property="ToolTipService.ShowDuration" Value="60000" />
            <Setter Property="ToolTip" Value="{StaticResource BranchDescriptionToolTip}" />
            <Style.Triggers>
                <Trigger Property="Tag" Value="">
                    <Setter Property="ToolTip" Value="{x:Null}" />
                </Trigger>
                <Trigger Property="Tag" Value="{x:Null}">
                    <Setter Property="ToolTip" Value="{x:Null}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Wiersz worktree wewnatrz karty projektu: cala szerokosc karty, obramowanie podswietla sie po najechaniu -->
        <Style x:Key="WorktreeButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="{StaticResource TextSubtle}" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="WorktreeBorder"
                                Background="#181A20"
                                BorderBrush="#383A43"
                                BorderThickness="1.5"
                                CornerRadius="8"
                                Padding="10,6">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="WorktreeBorder" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sciezka i agenci: widoczne po rozwinieciu karty -->
        <Style x:Key="CardDetailStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TagFilterButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#15161B" />
            <Setter Property="Foreground" Value="{StaticResource TextSubtle}" />
            <Setter Property="BorderBrush" Value="#383A43" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="TagButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TagButtonBorder" Property="Background" Value="#24262D" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="Background" Value="#24262D" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                                <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel Margin="18">
        <!-- Cale okno w powiekszeniu 120%, jak skala interfejsu w wizualizerze sesji; szerokosc okna uwzglednia to powiekszenie -->
        <DockPanel.LayoutTransform>
            <ScaleTransform ScaleX="1.2" ScaleY="1.2" />
        </DockPanel.LayoutTransform>
        <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Projekty"
                           FontSize="26"
                           FontWeight="Bold" />
                <StackPanel Orientation="Horizontal" Margin="1,3,0,0">
                    <TextBlock Text="wspolny rejestr repozytoriow"
                               Foreground="{StaticResource TextMuted}"
                               FontSize="11" />
                    <TextBlock Text="{Binding LauncherVersion, StringFormat=v{0}}"
                               Foreground="{StaticResource TextMuted}"
                               FontSize="11"
                               Margin="8,0,0,0" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="AddProjectButton"
                        Content="+"
                        Click="AddProjectButton_Click"
                        ToolTip="Dodaj projekt"
                        Style="{StaticResource HeaderButtonStyle}"
                        Margin="0,0,8,0" />

                <ToggleButton x:Name="SortByLaunchCountButton"
                              Content="Uruchomienia"
                              Tag="LaunchCount"
                              Click="SortModeButton_Click"
                              ToolTip="Sortuj po liczbie uruchomien"
                              Style="{StaticResource HeaderToggleButtonStyle}"
                              Margin="0,0,6,0" />

                <ToggleButton x:Name="SortByLastLaunchedButton"
                              Content="Ostatnio"
                              Tag="LastLaunched"
                              Click="SortModeButton_Click"
                              ToolTip="Sortuj po dacie ostatniego uruchomienia"
                              Style="{StaticResource HeaderToggleButtonStyle}"
                              Margin="0,0,6,0" />

                <ToggleButton x:Name="SortByNameButton"
                              Content="A–Z"
                              Tag="Name"
                              Click="SortModeButton_Click"
                              ToolTip="Sortuj alfabetycznie"
                              Style="{StaticResource HeaderToggleButtonStyle}"
                              Margin="0,0,8,0" />

                <Button x:Name="CloseButton"
                        Content="×"
                        Click="CloseButton_Click"
                        ToolTip="Zamknij"
                        Style="{StaticResource HeaderButtonStyle}" />
            </StackPanel>
        </Grid>

        <Border x:Name="TagsPanel"
                DockPanel.Dock="Right"
                Width="155"
                Margin="14,0,0,0"
                Padding="10"
                Background="#101116"
                BorderBrush="#30313A"
                BorderThickness="1"
                CornerRadius="9">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="Tagi"
                           Foreground="{StaticResource TextMuted}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Margin="1,0,0,8" />
                <!-- Przelacza glowna liste miedzy aktywnymi a odstawionymi projektami -->
                <ToggleButton x:Name="ShelvedToggleButton"
                              DockPanel.Dock="Bottom"
                              Content="{Binding ShelvedButtonText}"
                              IsChecked="{Binding ShowShelved, Mode=TwoWay}"
                              ToolTip="Pokaz odstawione projekty"
                              Style="{StaticResource HeaderToggleButtonStyle}"
                              HorizontalAlignment="Stretch"
                              Margin="0,10,0,0" />
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="Brak tagow — dodaj je w edycji projektu."
                                   Foreground="{StaticResource TextMuted}"
                                   FontSize="11"
                                   TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TagFilters.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding TagFilters}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Name}"
                                            Click="TagFilterButton_Click"
                                            Style="{StaticResource TagFilterButtonStyle}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Karty ukladaja sie wierszami w dwie kolumny; szerokosc karty wylicza kod po zmianie rozmiaru listy.
             Ta sama lista pokazuje aktywne albo odstawione projekty, zaleznie od przycisku pod tagami. -->
        <ListBox x:Name="ProjectsList"
                 ItemsSource="{Binding VisibleProjects}"
                 ItemContainerStyle="{StaticResource ProjectCardContainerStyle}"
                 Background="Transparent"
                 BorderThickness="0"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 PreviewMouseLeftButtonDown="ProjectsList_PreviewMouseLeftButtonDown"
                 MouseMove="ProjectsList_MouseMove"
                 Drop="ProjectsList_Drop"
                 AllowDrop="True">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <local:TwoColumnPanel ColumnGap="12" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource ProjectCardStyle}"
                            BorderBrush="{Binding Color, Converter={StaticResource ProjectColorToBrush}}"
                            ToolTipService.InitialShowDelay="250"
                            ToolTipService.ShowDuration="60000"
                            MouseLeftButtonUp="ProjectCard_MouseLeftButtonUp">
                        <Border.ToolTip>
                            <ToolTip DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                     Style="{StaticResource ProjectDescriptionToolTipStyle}">
                                <StackPanel>
                                    <TextBlock Text="Katalog"
                                               Foreground="{StaticResource TextMuted}"
                                               FontSize="10"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Path}"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,8" />

                                    <TextBlock Text="Opis"
                                               Visibility="{Binding Description, Converter={StaticResource EmptyTextToVisibility}}"
                                               Foreground="{StaticResource TextMuted}"
                                               FontSize="10"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Description}"
                                               Visibility="{Binding Description, Converter={StaticResource EmptyTextToVisibility}}"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,8" />

                                    <TextBlock Text="{Binding AgentNamesText}"
                                               Foreground="{Binding Color, Converter={StaticResource ProjectColorToBrush}}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </ToolTip>
                        </Border.ToolTip>

                        <Border.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Aktywuj"
                                          Click="RestoreProjectMenuItem_Click"
                                          Visibility="{Binding Shelved, Converter={StaticResource BooleanToVisibility}}" />
                                <MenuItem Header="Edytuj projekt" Click="EditDescriptionMenuItem_Click" />
                                <MenuItem Header="Odstaw"
                                          Click="ShelveProjectMenuItem_Click"
                                          Visibility="{Binding Shelved, Converter={StaticResource InverseBooleanToVisibility}}" />
                                <MenuItem Header="Usun"
                                          Click="DeleteProjectMenuItem_Click"
                                          Visibility="{Binding Shelved, Converter={StaticResource BooleanToVisibility}}" />
                            </ContextMenu>
                        </Border.ContextMenu>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Width="4"
                                    Height="22"
                                    CornerRadius="3"
                                    Background="{Binding Color, Converter={StaticResource ProjectColorToBrush}}"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Margin="0,1,0,0" />

                            <!-- Odstawione projekty nie maja numeru, bo klawisze 1-9 dotycza tylko aktywnych -->
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Number}"
                                       Visibility="{Binding Shelved, Converter={StaticResource InverseBooleanToVisibility}}"
                                       Foreground="{Binding Color, Converter={StaticResource ProjectColorToBrush}}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Top" />

                            <StackPanel Grid.Column="2">
                                <DockPanel>
                                    <ToggleButton DockPanel.Dock="Right"
                                                  IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                                  Style="{StaticResource ExpandToggleStyle}"
                                                  VerticalAlignment="Center" />

                                    <!-- Galaz i flaga stanu; ukryte, dopoki stan Git nie zostal odczytany albo gdy katalog nie jest repozytorium -->
                                    <StackPanel DockPanel.Dock="Right"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Margin="10,0,0,0">
                                        <StackPanel.Style>
                                            <Style TargetType="{x:Type StackPanel}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding GitStatus.IsRepository}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>

                                        <!-- Dymek z opisem zadania branch biezacej galezi -->
                                        <Border Background="#262933"
                                                CornerRadius="6"
                                                Padding="8,2"
                                                Style="{StaticResource BranchDescriptionHostStyle}"
                                                Tag="{Binding GitStatus.TaskDescription}">
                                            <TextBlock Text="{Binding GitStatus.Branch}"
                                                       Foreground="#E4DDCB"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       MaxWidth="190"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Border>

                                        <!-- Kropka i opis stanu w tym samym kolorze, zeby flaga byla czytelna z daleka -->
                                        <TextBlock FontSize="13"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center"
                                                   Margin="10,0,0,0">
                                            <Run Text="● " />
                                            <Run Text="{Binding GitStatus.StateLabel, Mode=OneWay}" />
                                            <TextBlock.Style>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding GitStatus.StateKind}" Value="Dirty">
                                                            <Setter Property="Foreground" Value="#FF9F1A" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding GitStatus.StateKind}" Value="CleanNotPushed">
                                                            <Setter Property="Foreground" Value="#F2C900" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding GitStatus.StateKind}" Value="Clean">
                                                            <Setter Property="Foreground" Value="#2ECC71" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>

                                    <TextBlock Text="{Binding Name}"
                                               FontSize="17"
                                               FontWeight="Bold"
                                               Foreground="#FFFFFF"
                                               TextTrimming="CharacterEllipsis" />
                                </DockPanel>

                                <DockPanel Margin="0,4,0,0">
                                    <TextBlock DockPanel.Dock="Right"
                                               Text="{Binding LaunchInfo}"
                                               Foreground="{StaticResource TextMuted}"
                                               FontSize="11"
                                               VerticalAlignment="Bottom"
                                               Margin="10,0,0,1" />

                                    <!-- Opis zawsze w calosci; strzalka rozwija tylko sciezke i agentow -->
                                    <TextBlock Text="{Binding Description}"
                                               Foreground="{StaticResource TextSubtle}"
                                               FontSize="13"
                                               TextWrapping="Wrap" />
                                </DockPanel>

                                <TextBlock Text="{Binding Path}"
                                           Style="{StaticResource CardDetailStyle}"
                                           Foreground="{StaticResource TextMuted}"
                                           Margin="0,6,0,0" />

                                <TextBlock Text="{Binding AgentNamesText}"
                                           Style="{StaticResource CardDetailStyle}"
                                           Foreground="{Binding Color, Converter={StaticResource ProjectColorToBrush}}"
                                           FontWeight="SemiBold"
                                           Margin="0,3,0,0" />

                                <!-- Dodatkowe worktree repozytorium jako wiersze z galezia, czystoscia i opisem zadania;
                                     klikniecie wiersza otwiera VS Code w katalogu worktree -->
                                <ItemsControl ItemsSource="{Binding GitStatus.Worktrees}"
                                              Margin="0,4,0,0">
                                    <ItemsControl.Style>
                                        <Style TargetType="{x:Type ItemsControl}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding GitStatus.Worktrees.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding GitStatus}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ItemsControl.Style>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource WorktreeButtonStyle}"
                                                    Click="_WorktreeButton_Click"
                                                    ToolTip="{Binding Path}">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right"
                                                                   FontSize="12"
                                                                   FontWeight="Bold"
                                                                   Margin="10,0,0,0">
                                                            <Run Text="● " />
                                                            <Run Text="{Binding StateLabel, Mode=OneWay}" />
                                                            <TextBlock.Style>
                                                                <Style TargetType="{x:Type TextBlock}">
                                                                    <Setter Property="Foreground" Value="#2ECC71" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                                                            <Setter Property="Foreground" Value="#FF9F1A" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="worktree "
                                                                       Foreground="{StaticResource TextMuted}"
                                                                       FontSize="13" />
                                                            <!-- Dymek z opisem zadania worktree albo tematem ostatniego commita -->
                                                            <Border Style="{StaticResource BranchDescriptionHostStyle}"
                                                                    Tag="{Binding Description}"
                                                                    Background="Transparent">
                                                                <TextBlock Text="{Binding Branch}"
                                                                           FontSize="13"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="#E4DDCB"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </Border>
                                                        </StackPanel>
                                                    </DockPanel>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
