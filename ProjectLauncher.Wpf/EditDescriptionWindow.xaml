<Window x:Class="ProjectLauncher.Wpf.EditDescriptionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edytuj projekt"
        Width="620"
        Height="570"
        WindowStartupLocation="CenterOwner"
        Background="#090A0F"
        Foreground="#F7F2E8"
        ResizeMode="NoResize">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBackground" Color="#15161B" />
        <SolidColorBrush x:Key="TextMuted" Color="#85858F" />
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="#15161B" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#3C3E48" />
            <Setter Property="CaretBrush" Value="#FFFFFF" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style TargetType="{x:Type Button}">
            <Setter Property="MinWidth" Value="90" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Background" Value="#15161B" />
            <Setter Property="Foreground" Value="#F7F2E8" />
            <Setter Property="BorderBrush" Value="#7C5CFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#1C1F29" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#A483FF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.76" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="Projekt"
                       FontSize="18"
                       FontWeight="SemiBold" />
            <TextBlock Text="Dane uzywane przez launcher i wizualizer sesji"
                       Foreground="{StaticResource TextMuted}"
                       FontSize="12"
                       Margin="0,4,0,0" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="150" />
            </Grid.ColumnDefinitions>

            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="Nazwa"
                           Foreground="{StaticResource TextMuted}"
                           FontSize="12"
                           Margin="0,0,0,5" />
                <TextBox x:Name="NameBox" />
            </StackPanel>

            <StackPanel Grid.Column="1">
                <TextBlock Text="Kolor"
                           Foreground="{StaticResource TextMuted}"
                           FontSize="12"
                           Margin="0,0,0,5" />
                <Button x:Name="ColorPickerButton"
                        MinWidth="0"
                        HorizontalContentAlignment="Stretch"
                        Click="ColorPickerButton_Click"
                        ToolTip="Wybierz kolor">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="ColorPreview"
                                CornerRadius="8"
                                BorderBrush="#3C3E48"
                                BorderThickness="1" />
                        <TextBlock Grid.Column="1"
                                   Text="Wybierz"
                                   Foreground="#F7F2E8"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0" />
                    </Grid>
                </Button>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <TextBlock Text="Imiona agentow"
                       Foreground="{StaticResource TextMuted}"
                       FontSize="12"
                       Margin="0,0,0,5" />
            <TextBox x:Name="AgentNamesBox" />
            <TextBlock Text="Oddziel imiona przecinkami, np. Watson, Sherlock, Vivaldi"
                       Foreground="{StaticResource TextMuted}"
                       FontSize="11"
                       Margin="0,5,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,0,0,12">
            <TextBlock Text="Tagi"
                       Foreground="{StaticResource TextMuted}"
                       FontSize="12"
                       Margin="0,0,0,5" />
            <TextBox x:Name="TagsBox" />
            <TextBlock Text="Oddziel tagi przecinkami, np. AI, C#, klient"
                       Foreground="{StaticResource TextMuted}"
                       FontSize="11"
                       Margin="0,5,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="0,0,0,12">
            <TextBlock Text="Opis"
                       Foreground="{StaticResource TextMuted}"
                       FontSize="12"
                       Margin="0,0,0,5" />
        </StackPanel>

        <TextBox x:Name="DescriptionBox"
                 Grid.Row="5"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" />

        <StackPanel Grid.Row="6"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button Content="Anuluj"
                    Click="CancelButton_Click"
                    Margin="0,0,8,0" />
            <Button Content="Zapisz"
                    Click="SaveButton_Click" />
        </StackPanel>
    </Grid>
</Window>
